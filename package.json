{
  "name": "site",
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://bncszb.github.io//",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "reinstall": "rm -rf node_modules && rm bun.lock && bun i",
    "deploy": "gh-pages -d build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.2",
    "gh-pages": "^6.3.0",
    "install": "^0.13.0",
    "svelte-icons-pack": "^3.1.3",
    "svelte-markdown": "^0.4.1"
  }
}
